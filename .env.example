# Aplicación
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=debug
TRUST_PROXY=1

# PostgreSQL
DATABASE_URL=postgresql://estudio_guzman_app:change-me@localhost:5432/estudio_guzman?schema=public
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/estudio_guzman?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/estudio_guzman_test?schema=public

# Bootstrap único del primer administrador (sin valores versionados)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Navegador y cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
SESSION_IDLE_MINUTES=480
SESSION_COOKIE_NAME=eg_session
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MINUTES=15
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Archivos privados
STORAGE_ROOT=./storage
MAX_FILE_SIZE_MB=50
MALWARE_SCAN_MODE=skip
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
WORKER_POLL_INTERVAL_MS=2000

[Unit]
Description=Estudio Guzman Worker
After=network-online.target postgresql.service

[Service]
Type=simple
User=estudio-guzman
Group=estudio-guzman
WorkingDirectory=/opt/estudio-guzman/backend
EnvironmentFile=/etc/estudio-guzman/backend.env
ExecStart=/usr/bin/node dist/worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/estudio-guzman/storage

[Install]
WantedBy=multi-user.target

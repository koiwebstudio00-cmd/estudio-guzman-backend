{
  "name": "estudio-guzman-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST para la gestión interna de Estudio Guzmán",
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts test/unit",
    "test:api": "vitest run --config vitest.config.ts test/api",
    "test:db:migrate": "prisma migrate deploy --config prisma.test.config.ts",
    "test:integration": "npm run test:db:migrate && vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "audit:runtime": "npm audit --omit=dev --omit=optional",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:grant-runtime": "prisma db execute --file prisma/operations/002_grant_runtime.sql",
    "seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "security:benchmark-argon2": "tsx scripts/benchmark-argon2.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "busboy": "^1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
